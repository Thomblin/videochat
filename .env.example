# rsync destination for `make release`
# Format: user@host:/path/to/deploy/dir
RSYNC_DEST=user@raspberry:/home/www-data/chat.example.com

# ICE servers as JSON array of RTCIceServer objects (defaults to Google STUN)
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:my.server:3478","username":"user","credential":"pass"}]
